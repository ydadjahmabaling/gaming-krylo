{
"functions": {
"api/index.php": {
"runtime": "vercel-php@0.9.0"
},
"api/api.php": {
"runtime": "vercel-php@0.9.0"
}
},
"routes": [
{
"handle": "filesystem"
},
{
"src": "/api.php",
"dest": "/api/api.php"
},
{
"src": "/api/(.)",
"dest": "/api/api.php"
},
{
"src": "/(.)",
"dest": "/api/index.php"
}
]
}